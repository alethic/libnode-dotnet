<Project Sdk="Microsoft.Build.NoTargets">

  <!--
    All the .NET work, on one machine: takes the raw per-RID Node build outputs that CI uploaded
    (out/libnode/<rid>/: libnode.{dll,lib,pdb} | libnode.so.N | libnode.N.dylib, config.gypi,
    llvm-version.txt), lays them out, and packs:

      Alethic.LibNode.<rid>   natives only, one per RID:
                                runtimes/<rid>/native/libnode.{dll,so,dylib} (+ .pdb)   (so/dylib renamed to plain names)
                                build/native/<rid>/{config.gypi, libnode.lib (Windows)}
                                build/native/Alethic.LibNode.<rid>.props      per-RID paths for native consumers
                                buildTransitive/net472/Alethic.LibNode.<rid>.targets   (Windows RIDs)
                                  .NET Framework has no RID asset selection, so this copies the package's
                                  natives into the output as runtimes\<rid>\native\ for a RID-probing loader.

      Alethic.LibNode         top-level, depends on every RID package (exact version):
                                build/native/include/...           C++ embedding headers from the submodule (install.py)
                                build/native/Alethic.LibNode.props version, LLVM version, include dir

    .NET (Core) consumers need nothing extra: runtimes/<rid>/native assets go into .deps.json and the
    matching one is copied on RID-specific build/publish.

    Usage:  dotnet build src/LibNode.Pack/LibNode.Pack.proj -t:PackAll [-p:BuildNumber=N]
    Version: <node version from the submodule>.<build number>, e.g. 26.10.0.17.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LibNodePackageIdPrefix Condition=" '$(LibNodePackageIdPrefix)' == '' ">Alethic.LibNode</LibNodePackageIdPrefix>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</RepoRoot>
    <NodeSourceDir>$(RepoRoot)ext\node\</NodeSourceDir>
    <LibNodeArtifactsDir Condition=" '$(LibNodeArtifactsDir)' == '' ">$(RepoRoot)out\libnode\</LibNodeArtifactsDir>
    <LibNodeStagingDir Condition=" '$(LibNodeStagingDir)' == '' ">$(RepoRoot)out\staging\</LibNodeStagingDir>
    <PackageOutputPath Condition=" '$(PackageOutputPath)' == '' ">$(RepoRoot)out\pkg\</PackageOutputPath>
    <BuildNumber Condition=" '$(BuildNumber)' == '' ">0</BuildNumber>
    <PythonExe Condition=" '$(PythonExe)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">python</PythonExe>
    <PythonExe Condition=" '$(PythonExe)' == '' ">python3</PythonExe>

    <Authors>Alethic</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/alethic/libnode</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alethic/libnode</RepositoryUrl>
    <PackageTags>native JavaScript JS V8 node.js node libnode Node-API NAPI embedding</PackageTags>

    <!-- Content-only packages. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Shared: version from the submodule, RIDs from the artifact directories. -->
  <Target Name="_ReadNodeVersion" Condition=" '$(NodeVersion)' == '' ">
    <Error Condition="!Exists('$(NodeSourceDir)tools\getnodeversion.py')" Text="Node submodule not checked out at $(NodeSourceDir) (git submodule update --init)." />
    <Exec Command="$(PythonExe) tools/getnodeversion.py" WorkingDirectory="$(NodeSourceDir)" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="NodeVersion" />
    </Exec>
    <PropertyGroup>
      <PackageVersion>$(NodeVersion).$(BuildNumber)</PackageVersion>
      <Version>$(PackageVersion)</Version>
    </PropertyGroup>
  </Target>

  <Target Name="_DiscoverRids">
    <ItemGroup>
      <_ConfigGypi Include="$(LibNodeArtifactsDir)*\config.gypi" />
      <_Rid Include="@(_ConfigGypi->'%(RootDir)%(Directory)')">
        <Rid>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(RootDir)%(Directory)'))))</Rid>
      </_Rid>
    </ItemGroup>
    <Error Condition=" '@(_Rid)' == '' " Text="No Node build outputs under $(LibNodeArtifactsDir)&lt;rid&gt;/ (expected config.gypi beside the libnode binary)." />
  </Target>

  <!-- ============================================================================================ -->
  <!-- Per-RID package (PackRid)                                                                    -->
  <!-- ============================================================================================ -->

  <PropertyGroup Condition=" '$(PackRid)' != '' ">
    <PackageId>$(LibNodePackageIdPrefix).$(PackRid)</PackageId>
    <Description>Node.js shared library (libnode) native binaries for $(PackRid). Unpatched upstream Node.js. Referenced by $(LibNodePackageIdPrefix).</Description>
    <_ArtifactDir>$(LibNodeArtifactsDir)$(PackRid)\</_ArtifactDir>
    <_RidStaging>$(LibNodeStagingDir)$(PackRid)\</_RidStaging>
    <_RidKey>$(PackRid.Replace('-', '_'))</_RidKey>
    <_IsWindowsRid>$(PackRid.StartsWith('win-'))</_IsWindowsRid>
    <_PlatformTarget Condition=" '$(PackRid)' == 'win-x64' ">x64</_PlatformTarget>
    <_PlatformTarget Condition=" '$(PackRid)' == 'win-x86' ">x86</_PlatformTarget>
    <_PlatformTarget Condition=" '$(PackRid)' == 'win-arm64' ">ARM64</_PlatformTarget>
  </PropertyGroup>

  <ItemGroup Condition=" '$(PackRid)' != '' ">
    <None Include="$(MSBuildThisFileDirectory)_._" Pack="true" PackagePath="lib/netstandard2.0/" Visible="false" />
  </ItemGroup>

  <!-- Stage the RID's files with normalized names, then generate its props/targets. -->
  <Target Name="_StageRid" DependsOnTargets="_ReadNodeVersion" Condition=" '$(PackRid)' != '' ">
    <Error Condition="!Exists('$(_ArtifactDir)config.gypi')" Text="No Node build outputs for $(PackRid) at $(_ArtifactDir)." />
    <ItemGroup>
      <!-- Explicit paths (not globs) are included whether or not the file exists, so guard each one. -->
      <_Dll Include="$(_ArtifactDir)libnode.dll" Condition="Exists('$(_ArtifactDir)libnode.dll')" />
      <_Dll Include="$(_ArtifactDir)libnode.pdb" Condition="Exists('$(_ArtifactDir)libnode.pdb')" />
      <_So Include="$(_ArtifactDir)libnode.so*" />
      <_Dylib Include="$(_ArtifactDir)libnode*.dylib" />
      <_ImportLib Include="$(_ArtifactDir)libnode.lib" Condition="Exists('$(_ArtifactDir)libnode.lib')" />
      <_LlvmVersionFile Include="$(_ArtifactDir)llvm-version.txt" Condition="Exists('$(_ArtifactDir)llvm-version.txt')" />
    </ItemGroup>
    <Error Condition=" '@(_Dll)' == '' AND '@(_So)' == '' AND '@(_Dylib)' == '' " Text="No libnode binary found in $(_ArtifactDir)." />
    <ReadLinesFromFile File="@(_LlvmVersionFile)" Condition=" '@(_LlvmVersionFile)' != '' ">
      <Output TaskParameter="Lines" ItemName="_LlvmVersionLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <!-- Items expand after property functions, so go through a property before matching. -->
      <_LlvmVersionText>@(_LlvmVersionLine)</_LlvmVersionText>
      <LibNodeLlvmVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_LlvmVersionText)', '\d+\.\d+\.\d+').Value)</LibNodeLlvmVersion>
      <_NativeDir>$(_RidStaging)runtimes\$(PackRid)\native\</_NativeDir>
      <_BuildDir>$(_RidStaging)build\native\$(PackRid)\</_BuildDir>
    </PropertyGroup>

    <RemoveDir Directories="$(_RidStaging)" />
    <Copy SourceFiles="@(_Dll)" DestinationFolder="$(_NativeDir)" Condition=" '@(_Dll)' != '' " />
    <!-- libnode.so.N / libnode.N.dylib -> plain names; consumers load by path, not by soname. -->
    <Copy SourceFiles="@(_So)" DestinationFiles="$(_NativeDir)libnode.so" Condition=" '@(_So)' != '' " />
    <Copy SourceFiles="@(_Dylib)" DestinationFiles="$(_NativeDir)libnode.dylib" Condition=" '@(_Dylib)' != '' " />
    <Copy SourceFiles="@(_ImportLib)" DestinationFolder="$(_BuildDir)" Condition=" '@(_ImportLib)' != '' " />
    <Copy SourceFiles="$(_ArtifactDir)config.gypi" DestinationFolder="$(_BuildDir)" />

    <ItemGroup>
      <_PropsLine Include="&lt;Project&gt;" />
      <_PropsLine Include="  &lt;PropertyGroup&gt;" />
      <_PropsLine Include="    &lt;LibNodeVersion&gt;$(NodeVersion)&lt;/LibNodeVersion&gt;" />
      <_PropsLine Include="    &lt;LibNodeLlvmVersion&gt;$(LibNodeLlvmVersion)&lt;/LibNodeLlvmVersion&gt;" />
      <_PropsLine Include="    &lt;LibNodeNativeDir_$(_RidKey)&gt;%24(MSBuildThisFileDirectory)..\..\runtimes\$(PackRid)\native\&lt;/LibNodeNativeDir_$(_RidKey)&gt;" />
      <_PropsLine Include="    &lt;LibNodeBuildDir_$(_RidKey)&gt;%24(MSBuildThisFileDirectory)$(PackRid)\&lt;/LibNodeBuildDir_$(_RidKey)&gt;" />
      <_PropsLine Include="  &lt;/PropertyGroup&gt;" />
      <_PropsLine Include="&lt;/Project&gt;" />

      <_TargetsLine Include="&lt;Project&gt;" />
      <_TargetsLine Include="  &lt;!-- .NET Framework fallback: no RID asset selection, so copy this package's natives into the output as runtimes\$(PackRid)\native\. Set LibNodeCopyNatives=false to opt out. --&gt;" />
      <_TargetsLine Include="  &lt;PropertyGroup&gt;" />
      <_TargetsLine Include="    &lt;LibNodeCopyNatives Condition=&quot; '%24(LibNodeCopyNatives)' == '' &quot;&gt;true&lt;/LibNodeCopyNatives&gt;" />
      <_TargetsLine Include="  &lt;/PropertyGroup&gt;" />
      <_TargetsLine Include="  &lt;ItemGroup Condition=&quot; '%24(LibNodeCopyNatives)' == 'true' AND ('%24(PlatformTarget)' == '' OR '%24(PlatformTarget)' == 'AnyCPU' OR '%24(PlatformTarget)' == '$(_PlatformTarget)') &quot;&gt;" />
      <!-- %2A is '*': a literal * in an item Include would be treated as a file glob. -->
      <_TargetsLine Include="    &lt;None Include=&quot;%24(MSBuildThisFileDirectory)..\..\runtimes\$(PackRid)\native\%2A&quot; Link=&quot;runtimes\$(PackRid)\native\%25(Filename)%25(Extension)&quot; CopyToOutputDirectory=&quot;PreserveNewest&quot; Visible=&quot;false&quot; /&gt;" />
      <_TargetsLine Include="  &lt;/ItemGroup&gt;" />
      <_TargetsLine Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_RidStaging)build\native\$(PackageId).props" Lines="@(_PropsLine)" Overwrite="true" />
    <WriteLinesToFile File="$(_RidStaging)buildTransitive\net472\$(PackageId).targets" Lines="@(_TargetsLine)" Overwrite="true" Condition=" '$(_IsWindowsRid)' == 'true' " />

    <ItemGroup>
      <!-- NuGet appends each item's RecursiveDir to PackagePath, so the staging tree maps 1:1 onto the package root. -->
      <_Staged Include="$(_RidStaging)**\*" />
      <None Include="@(_Staged)" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>
    <Message Importance="normal" Text="llvm-version.txt: @(_LlvmVersionFile) -> '@(_LlvmVersionLine)'" />
    <Message Importance="high" Text="Packing $(PackageId) $(PackageVersion) (LLVM $(LibNodeLlvmVersion))" />
  </Target>
  <Target Name="_StageRidBeforePack" DependsOnTargets="_StageRid" BeforeTargets="_GetPackageFiles" Condition=" '$(PackRid)' != '' " />

  <!-- ============================================================================================ -->
  <!-- Top-level package (PackMeta): nuspec, since its dependencies are not restorable yet          -->
  <!-- ============================================================================================ -->

  <PropertyGroup Condition=" '$(PackMeta)' == 'true' ">
    <PackageId>$(LibNodePackageIdPrefix)</PackageId>
    <NuspecFile>$(MSBuildThisFileDirectory)LibNode.meta.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildThisFileDirectory)</NuspecBasePath>
    <_MetaStaging>$(LibNodeStagingDir)meta\</_MetaStaging>
  </PropertyGroup>

  <Target Name="_PrepareMetaNuspec" DependsOnTargets="_ReadNodeVersion;_DiscoverRids" BeforeTargets="GenerateNuspec" Condition=" '$(PackMeta)' == 'true' ">
    <PropertyGroup>
      <_Rids>@(_Rid->'%(Rid)', ';')</_Rids>
      <_Deps>@(_Rid->'&lt;dependency id=&quot;$(LibNodePackageIdPrefix).%(Rid)&quot; version=&quot;[$(PackageVersion)]&quot; /&gt;', '')</_Deps>
      <_IncludeDir>$(_MetaStaging)include\</_IncludeDir>
      <_MetaProps>$(_MetaStaging)$(PackageId).props</_MetaProps>
    </PropertyGroup>
    <ItemGroup>
      <_FirstLlvm Include="$(LibNodeArtifactsDir)*\llvm-version.txt" />
    </ItemGroup>
    <ReadLinesFromFile File="%(_FirstLlvm.FullPath)" Condition=" '@(_FirstLlvm)' != '' ">
      <Output TaskParameter="Lines" ItemName="_MetaLlvmLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_MetaLlvmText>@(_MetaLlvmLine)</_MetaLlvmText>
      <LibNodeLlvmVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_MetaLlvmText)', '\d+\.\d+\.\d+').Value)</LibNodeLlvmVersion>
      <!-- %3B is ';', which WriteLinesToFile would otherwise treat as a line separator. -->
      <_RidsEscaped>$(_Rids.Replace(';', '%3B'))</_RidsEscaped>
    </PropertyGroup>

    <!-- Headers: Node's own installer gives the canonical include/node layout (node.h, v8*.h, uv, cppgc, node_api*).
         The header set is the same on every platform; any RID's config.gypi satisfies install.py. -->
    <PropertyGroup>
      <_AnyConfigGypi>%(_ConfigGypi.FullPath)</_AnyConfigGypi>
    </PropertyGroup>
    <RemoveDir Directories="$(_MetaStaging)" />
    <Exec Command="$(PythonExe) tools/install.py install --headers-only --root-dir . --config-gypi-path &quot;$(_AnyConfigGypi)&quot; --dest-dir &quot;$(_IncludeDir).&quot; --prefix /" WorkingDirectory="$(NodeSourceDir)" />

    <ItemGroup>
      <_MetaPropsLine Include="&lt;Project&gt;" />
      <_MetaPropsLine Include="  &lt;PropertyGroup&gt;" />
      <_MetaPropsLine Include="    &lt;LibNodeVersion&gt;$(NodeVersion)&lt;/LibNodeVersion&gt;" />
      <_MetaPropsLine Include="    &lt;LibNodeLlvmVersion&gt;$(LibNodeLlvmVersion)&lt;/LibNodeLlvmVersion&gt;" />
      <_MetaPropsLine Include="    &lt;LibNodeRuntimeIdentifiers&gt;$(_RidsEscaped)&lt;/LibNodeRuntimeIdentifiers&gt;" />
      <_MetaPropsLine Include="    &lt;LibNodeIncludeDir&gt;%24(MSBuildThisFileDirectory)include\&lt;/LibNodeIncludeDir&gt;" />
      <_MetaPropsLine Include="  &lt;/PropertyGroup&gt;" />
      <_MetaPropsLine Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_MetaProps)" Lines="@(_MetaPropsLine)" Overwrite="true" />
    <PropertyGroup>
      <NuspecProperties>id=$(PackageId);version=$(PackageVersion);prefix=$(LibNodePackageIdPrefix);dependencies=$(_Deps);includeDir=$(_IncludeDir.TrimEnd('\'));propsFile=$(_MetaProps);readme=$(RepoRoot)README.md</NuspecProperties>
    </PropertyGroup>
    <Message Importance="high" Text="Packing $(PackageId) $(PackageVersion) depending on RIDs: $(_Rids)" />
  </Target>

  <!-- ============================================================================================ -->
  <!-- Driver                                                                                        -->
  <!-- ============================================================================================ -->

  <Target Name="PackAll" DependsOnTargets="_DiscoverRids">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore;Pack" Properties="PackRid=%(_Rid.Rid);BuildNumber=$(BuildNumber);LibNodeArtifactsDir=$(LibNodeArtifactsDir);LibNodeStagingDir=$(LibNodeStagingDir);LibNodePackageIdPrefix=$(LibNodePackageIdPrefix);PackageOutputPath=$(PackageOutputPath)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore;Pack" Properties="PackMeta=true;BuildNumber=$(BuildNumber);LibNodeArtifactsDir=$(LibNodeArtifactsDir);LibNodeStagingDir=$(LibNodeStagingDir);LibNodePackageIdPrefix=$(LibNodePackageIdPrefix);PackageOutputPath=$(PackageOutputPath)" />
    <Message Importance="high" Text="Packages written to $(PackageOutputPath)" />
  </Target>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>$id$</id>
    <version>$version$</version>
    <authors>Alethic</authors>
    <description>Node.js built as a shared library (libnode) for every supported runtime identifier, with the C++ embedding headers. Depends on the per-RID native packages ($prefix$.&lt;rid&gt;). Unpatched upstream Node.js.</description>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/alethic/libnode</projectUrl>
    <repository type="git" url="https://github.com/alethic/libnode" />
    <readme>README.md</readme>
    <tags>native JavaScript JS V8 node.js node libnode Node-API NAPI embedding</tags>
    <dependencies>
      <group>
        $dependencies$
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="$readme$" target="README.md" />
    <file src="_._" target="lib/netstandard2.0/_._" />
    <file src="$propsFile$" target="build/native/$id$.props" />
    <file src="$includeDir$/**" target="build/native/include" exclude="$includeDir$/config.gypi" />
  </files>
</package>

<Project Sdk="Microsoft.Build.NoTargets">
    <PropertyGroup>
        <Description>Node.js shared library (libnode) and its node-dotnet embedding shim, for win-arm64.</Description>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="." />
        <None Include="buildTransitive\**\*" Pack="true" PackagePath="buildTransitive\%(RecursiveDir)%(Filename)%(Extension)" />
        <None Include="$(LibNodeDir)win-arm64\libnode.dll" Pack="true" PackagePath="runtimes\win-arm64\native\" />
        <None Include="$(LibNodeDir)win-arm64\node-dotnet.dll" Pack="true" PackagePath="runtimes\win-arm64\native\" />
    </ItemGroup>
</Project>

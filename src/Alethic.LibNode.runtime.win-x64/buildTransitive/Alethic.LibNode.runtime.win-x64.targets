<Project>
    <!-- .NET Framework does not resolve runtimes\<rid>\native assets: copy them to the output under the same path. -->
    <ItemGroup Condition=" '$(TargetFrameworkIdentifier)' == '.NETFramework' ">
        <None Include="$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\*.dll" Link="runtimes\win-x64\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
</Project>

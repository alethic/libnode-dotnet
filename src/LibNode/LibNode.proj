<Project Sdk="Microsoft.Build.NoTargets">

  <!--
    Builds Node.js from the ext/node submodule as a shared library (libnode) using Node's own
    build system (configure + gyp + ninja), then harvests the outputs for packaging and for the
    NodeApi.Embedding.Native shim to compile against.

    Node builds in its standard location, ext/node/out/<config>/. This project does not relocate
    the build; it only drives it and copies results out.

    Toolchain policy: Node is compiled with the same standalone LLVM that IKVM.Clang uses for the
    shim, so both sides of the C++ ABI come from one compiler. On Windows that is clang-cl with
    MSVC's STL, link.exe and the Windows SDK supplied by a Visual Studio C++ installation (no VS
    clang components needed). Linking stays with the platform linker.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <NodeSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'ext', 'node'))</NodeSourceDir>
    <NodeBuildConfig Condition=" '$(NodeBuildConfig)' == '' ">Release</NodeBuildConfig>
    <NodeOutDir>$(NodeSourceDir)out\$(NodeBuildConfig)\</NodeOutDir>

    <!-- The git HEAD of the submodule; changes when the pinned Node commit moves. -->
    <NodeSubmoduleHead>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', '.git', 'modules', 'ext', 'node', 'HEAD'))</NodeSubmoduleHead>

    <!-- Where harvested outputs land: runtimes/<rid>/native, include/, lib/. -->
    <LibNodeHarvestDir>$(OutputPath)</LibNodeHarvestDir>
  </PropertyGroup>

  <!-- Runtime identifier of the libnode being built. Defaults to the host. -->
  <PropertyGroup Condition=" '$(LibNodeRuntimeIdentifier)' == '' ">
    <_HostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_HostArch>
    <LibNodeRuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-$(_HostArch)</LibNodeRuntimeIdentifier>
    <LibNodeRuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-$(_HostArch)</LibNodeRuntimeIdentifier>
    <LibNodeRuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-$(_HostArch)</LibNodeRuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup>
    <LibNodeTargetCpu Condition="$(LibNodeRuntimeIdentifier.EndsWith('-x64'))">x64</LibNodeTargetCpu>
    <LibNodeTargetCpu Condition="$(LibNodeRuntimeIdentifier.EndsWith('-arm64'))">arm64</LibNodeTargetCpu>
    <LibNodeTargetCpu Condition="$(LibNodeRuntimeIdentifier.EndsWith('-x86'))">x86</LibNodeTargetCpu>
  </PropertyGroup>

  <!-- LLVM toolchain. Override LlvmInstallDir / LlvmVersion to use a different install. -->
  <PropertyGroup>
    <LlvmInstallDir Condition=" '$(LlvmInstallDir)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">$(ProgramFiles)\LLVM\</LlvmInstallDir>
    <LlvmInstallDir Condition=" '$(LlvmInstallDir)' == '' ">/usr/lib/llvm-20/</LlvmInstallDir>
    <LlvmBinDir>$([MSBuild]::NormalizeDirectory('$(LlvmInstallDir)', 'bin'))</LlvmBinDir>
  </PropertyGroup>

  <!-- Extra tool directories that may not be on PATH (winget installs). -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <LibNodeToolDir Include="$(LlvmBinDir)" />
    <LibNodeToolDir Include="$(LOCALAPPDATA)\bin\NASM" />
    <LibNodeToolDir Include="$(ProgramFiles)\NASM" />
    <LibNodeToolDir Include="$(LOCALAPPDATA)\Microsoft\WinGet\Links" />
    <LibNodeToolDir Include="$(USERPROFILE)\.cargo\bin" />
  </ItemGroup>

  <!--
    Generator selection. ninja everywhere except Windows: Node 26's deps/crates/crates.gyp uses the
    MSBuild macro $(Platform) on Windows, which only the msvs generator expands, so Windows builds
    node.sln with msbuild and the ClangCL platform toolset pointed at our LLVM via LLVMInstallDir.
    Set LibNodeUseNinja=true to opt back in once that is fixed upstream.
  -->
  <PropertyGroup>
    <LibNodeUseNinja Condition=" '$(LibNodeUseNinja)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">false</LibNodeUseNinja>
    <LibNodeUseNinja Condition=" '$(LibNodeUseNinja)' == '' ">true</LibNodeUseNinja>
  </PropertyGroup>

  <!-- Node configure arguments common to all platforms. -->
  <ItemGroup>
    <NodeConfigureArg Include="--shared" />
    <NodeConfigureArg Include="--ninja" Condition=" '$(LibNodeUseNinja)' == 'true' " />
    <NodeConfigureArg Include="--dest-cpu=$(LibNodeTargetCpu)" />
  </ItemGroup>

  <!--
    ================================================================================================
    Windows
    ================================================================================================
  -->

  <!-- Locate Visual Studio (for MSVC headers/libs, link.exe, Windows SDK) via vswhere. -->
  <Target Name="LocateVisualStudio" Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(VsInstallDir)' == ''">
    <PropertyGroup>
      <_VsWhere>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</_VsWhere>
    </PropertyGroup>
    <Exec Command="&quot;$(_VsWhere)&quot; -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsInstallDir" />
    </Exec>
    <Error Condition=" '$(VsInstallDir)' == '' " Text="Visual Studio with the C++ workload (MSVC toolset + Windows SDK) was not found; it is required to build libnode on Windows." />
    <PropertyGroup>
      <VsInstallDir>$([MSBuild]::EnsureTrailingSlash('$(VsInstallDir)'))</VsInstallDir>
      <_VcVarsArch Condition=" '$(LibNodeTargetCpu)' == 'x64' ">amd64</_VcVarsArch>
      <_VcVarsArch Condition=" '$(LibNodeTargetCpu)' == 'x86' ">amd64_x86</_VcVarsArch>
      <_VcVarsArch Condition=" '$(LibNodeTargetCpu)' == 'arm64' ">amd64_arm64</_VcVarsArch>
      <VsVcVarsCommand>call &quot;$(VsInstallDir)VC\Auxiliary\Build\vcvarsall.bat&quot; $(_VcVarsArch) &gt;nul</VsVcVarsCommand>
    </PropertyGroup>
  </Target>

  <!-- Detect the clang-cl version; configure needs it for --clang-cl=. -->
  <Target Name="DetectLlvmVersion" Condition=" '$(LlvmVersion)' == '' ">
    <Exec Command="&quot;$(LlvmBinDir)clang&quot; --version" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_ClangVersionLine" />
    </Exec>
    <PropertyGroup>
      <_ClangVersionFirstLine>@(_ClangVersionLine)</_ClangVersionFirstLine>
      <_ClangVersionFirstLine>$(_ClangVersionFirstLine.Split(';')[0])</_ClangVersionFirstLine>
      <LlvmVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_ClangVersionFirstLine)', '\d+\.\d+\.\d+').Value)</LlvmVersion>
    </PropertyGroup>
    <Error Condition=" '$(LlvmVersion)' == '' " Text="Could not determine clang version from '$(LlvmBinDir)clang --version'." />
  </Target>

  <Target Name="PrepareNodeBuildEnvironment" DependsOnTargets="LocateVisualStudio;DetectLlvmVersion">
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <!-- gyp cannot find VS 2017+ via the registry; point it at the install like vcbuild.bat does. -->
      <_NodeEnvCommand>$(VsVcVarsCommand) &amp;&amp; set &quot;PATH=@(LibNodeToolDir, ';');%PATH%&quot; &amp;&amp; set GYP_MSVS_VERSION=2026 &amp;&amp; set &quot;GYP_MSVS_OVERRIDE_PATH=$(VsInstallDir)&quot;</_NodeEnvCommand>
      <_NodeConfigureCommand>python configure @(NodeConfigureArg, ' ') --clang-cl=$(LlvmVersion)</_NodeConfigureCommand>
      <!-- ninja: make gyp compile with our clang-cl (make_global_settings). msvs: the ClangCL toolset is told where LLVM is instead. -->
      <_NodeConfigureCommand Condition=" '$(LibNodeUseNinja)' == 'true' ">$(_NodeConfigureCommand) -I &quot;$(MSBuildThisFileDirectory)toolchain.win.gypi&quot;</_NodeConfigureCommand>

      <_MsBuildPlatform Condition=" '$(LibNodeTargetCpu)' == 'x64' ">x64</_MsBuildPlatform>
      <_MsBuildPlatform Condition=" '$(LibNodeTargetCpu)' == 'arm64' ">ARM64</_MsBuildPlatform>
      <_MsBuildPlatform Condition=" '$(LibNodeTargetCpu)' == 'x86' ">Win32</_MsBuildPlatform>
      <_NodeBuildCommand Condition=" '$(LibNodeUseNinja)' == 'true' ">ninja -C &quot;$(NodeOutDir).&quot; $(NodeNinjaTargets)</_NodeBuildCommand>
      <_NodeBuildCommand Condition=" '$(LibNodeUseNinja)' != 'true' ">msbuild node.sln /m /nologo /clp:NoItemAndPropertyList;Verbosity=minimal /p:Configuration=$(NodeBuildConfig) /p:Platform=$(_MsBuildPlatform) /p:LLVMInstallDir=&quot;$(LlvmInstallDir.TrimEnd('\'))&quot; /p:LLVMToolsVersion=$(LlvmVersion)</_NodeBuildCommand>
    </PropertyGroup>
    <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
      <_NodeEnvCommand>export CC=&quot;$(LlvmBinDir)clang&quot; CXX=&quot;$(LlvmBinDir)clang++&quot;</_NodeEnvCommand>
      <_NodeConfigureCommand>./configure @(NodeConfigureArg, ' ')</_NodeConfigureCommand>
      <_NodeBuildCommand>ninja -C &quot;$(NodeOutDir).&quot; $(NodeNinjaTargets)</_NodeBuildCommand>
    </PropertyGroup>
  </Target>

  <!--
    ================================================================================================
    Configure + build
    ================================================================================================
  -->

  <!-- Re-run configure when the pinned Node commit or our toolchain inputs change. -->
  <Target Name="ConfigureNode"
          DependsOnTargets="PrepareNodeBuildEnvironment"
          Inputs="$(NodeSubmoduleHead);$(MSBuildThisFileDirectory)toolchain.win.gypi;$(MSBuildThisFileFullPath)"
          Outputs="$(NodeSourceDir)config.gypi">
    <Message Importance="high" Text="Configuring Node.js ($(LibNodeRuntimeIdentifier), $(NodeBuildConfig)) with LLVM $(LlvmVersion) from $(LlvmBinDir)" />
    <Exec Command="$(_NodeEnvCommand) &amp;&amp; $(_NodeConfigureCommand)" WorkingDirectory="$(NodeSourceDir)" />
  </Target>

  <Target Name="BuildNode" DependsOnTargets="ConfigureNode">
    <Message Importance="high" Text="Building libnode ($(LibNodeRuntimeIdentifier), $(NodeBuildConfig)) in $(NodeOutDir)" />
    <Exec Command="$(_NodeEnvCommand) &amp;&amp; $(_NodeBuildCommand)" WorkingDirectory="$(NodeSourceDir)" />
  </Target>

  <!--
    ================================================================================================
    Harvest
    ================================================================================================
    Layout mirrors the Microsoft.JavaScript.LibNode.<rid> package, extended with the C++ embedding
    headers (node.h, v8, uv, cppgc) and config.gypi that the shim needs:

      runtimes/<rid>/native/libnode.{dll,so,dylib} (+ .pdb)
      lib/<rid>/libnode.lib                          (Windows import library)
      include/node/...                               (install.py - -headers-only layout)
      include/config.gypi
  -->

  <Target Name="HarvestNode" DependsOnTargets="BuildNode" AfterTargets="Build">
    <PropertyGroup>
      <_NativeDir>$(LibNodeHarvestDir)runtimes\$(LibNodeRuntimeIdentifier)\native\</_NativeDir>
      <_LibDir>$(LibNodeHarvestDir)lib\$(LibNodeRuntimeIdentifier)\</_LibDir>
      <_IncludeDir>$(LibNodeHarvestDir)include\</_IncludeDir>
    </PropertyGroup>
    <ItemGroup>
      <_LibNodeBinary Include="$(NodeOutDir)libnode.dll;$(NodeOutDir)libnode.pdb" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <_LibNodeBinary Include="$(NodeOutDir)lib/libnode.so*" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
      <_LibNodeBinary Include="$(NodeOutDir)lib/libnode.*.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <_LibNodeImportLib Include="$(NodeOutDir)libnode.lib" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>
    <Error Condition=" '@(_LibNodeBinary)' == '' " Text="No libnode binary found in $(NodeOutDir) after build." />

    <Copy SourceFiles="@(_LibNodeBinary)" DestinationFolder="$(_NativeDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_LibNodeImportLib)" DestinationFolder="$(_LibDir)" SkipUnchangedFiles="true" Condition=" '@(_LibNodeImportLib)' != '' " />

    <!-- Node's own header installer gives the canonical include/node layout (node.h, v8*.h, uv*, cppgc, node_api*). -->
    <Exec Command="python tools/install.py install --headers-only --root-dir . --config-gypi-path config.gypi --dest-dir &quot;$(_IncludeDir).&quot; --prefix /" WorkingDirectory="$(NodeSourceDir)" />
    <Copy SourceFiles="$(NodeSourceDir)config.gypi" DestinationFolder="$(_IncludeDir)" SkipUnchangedFiles="true" />

    <Message Importance="high" Text="libnode harvested to $(LibNodeHarvestDir)" />
  </Target>

  <!-- Consumers (the shim project, packaging) call this to learn where things are. -->
  <Target Name="GetLibNodeOutputs" DependsOnTargets="HarvestNode" Returns="@(LibNodeOutput)">
    <ItemGroup>
      <LibNodeOutput Include="$(LibNodeHarvestDir)">
        <RuntimeIdentifier>$(LibNodeRuntimeIdentifier)</RuntimeIdentifier>
        <NativeDir>$(LibNodeHarvestDir)runtimes\$(LibNodeRuntimeIdentifier)\native\</NativeDir>
        <LibDir>$(LibNodeHarvestDir)lib\$(LibNodeRuntimeIdentifier)\</LibDir>
        <IncludeDir>$(LibNodeHarvestDir)include\</IncludeDir>
        <LlvmVersion>$(LlvmVersion)</LlvmVersion>
      </LibNodeOutput>
    </ItemGroup>
  </Target>

</Project>
